# Cleanup job
APPLY=false
LOG_DIR=/app-data/oshvl-ops-agent/logs
REPORT_DIR=/app-data/oshvl-ops-agent/reports
RUNNER_USER=
RUNNER_HOME=

# App-data discovery root (override only for local testing)
APP_DATA_ROOT=/app-data

# Daily job — Database Configuration
PG_HOST=
PG_PORT=5432
PG_DATABASE=oshvl_prod
PG_USER=postgres
PG_PASSWORD=

# Daily job — AWS S3 (database backup destination)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Daily job — Notification via shovel.bot
SHOVEL_BOT_URL=https://api.shovel.bot
SHOVEL_BOT_API_KEY=
SHOVEL_BOT_CHANNEL=#all-orangeshovel

EXPORT_DIR=/app-data/oshvl-ops-agent/exports
